# Threshold monitor on the cart's domain metric: DEVIATING when the 95th
# percentile add-to-cart latency exceeds 50ms. Binds to the cart service instance.
# (p95 from the histogram buckets -- alerts on tail latency, not the mean.)
nodes:
- _type: Monitor
  function: urn:stackpack:common:monitor-function:threshold
  arguments:
    comparator: GT
    failureState: DEVIATING
    metric:
      aliasTemplate: Add-to-cart latency 95th percentile
      query: >-
        histogram_quantile(0.95, sum by (service_namespace, service_name, service_instance_id, le)
        (rate(demo_cart_add_item_latency_seconds_bucket{service_name=~"cart|cartservice"}[5m]))) * 1000
      unit: ms
    threshold: 50.0
    titleTemplate: Add-to-cart latency
    urnTemplate: "urn:opentelemetry:namespace/${service_namespace}:service/${service_name}:serviceInstance/${service_instance_id}"
  description: |-
    Monitors the cart service's own add-to-cart latency (the demo_cart_add_item_latency
    histogram). When the 95th percentile exceeds the threshold (default 50ms) the
    cart service instance goes to a Deviating state. This is a domain-specific health
    signal driven by the same metric shown on the cart presentation.
  identifier: urn:stackpack:<< .Name >>:shared:monitor:cart-add-item-latency
  intervalSeconds: 30
  name: Add-to-cart latency (Custom)
  remediationHint: !include "remediation-hints/cart-add-item-latency.md.hbs"
  status: ENABLED
  tags:
  - cart
  - latency

# Source component data monitor on the database component's own source: the data
# the database component mapping above produced. DEVIATING when that source does
# not report a service.version. The expressions are CEL; `vars` are named values
# the other expressions read as `vars.<name>`.
- _type: Monitor
  function: urn:stackpack:common:monitor-function:source-component-data
  arguments:
    query: 'label = "source-type:<< .Name >> database"'
    sourceSelector: '"<< .Name >>" in source.tags[?"stackpack"].orValue([])'
    vars:
      version: 'source.tags[?"service.version"].orValue([""])[0]'
      unversioned: 'vars.version == ""'
    health: 'vars.unversioned ? "DEVIATING" : "CLEAR"'
    title: '"Database version"'
    reason: 'vars.unversioned ? "The database does not report a service.version" : "The database runs version " + vars.version'
    data: '{"version": vars.version}'
  description: |-
    Checks that the webshop database reports the version it runs, from the data
    its component mapping produced. Components without a version are Deviating.
    Use this as a starting point for monitors that judge a component from its own
    source data, such as a status or configuration field the mapping sets.
  identifier: urn:stackpack:<< .Name >>:shared:monitor:database-version
  intervalSeconds: 30
  name: Database version (Custom)
  status: ENABLED
  tags:
  - database
