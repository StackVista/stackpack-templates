nodes:
- _type: Dashboard
  name: Pod resources
  description: ''
  identifier: urn:stackpack:<< .Name >>:shared:dashboard:pod-resources
  dashboard:
    metadata:
      project: '{"saveVariables":false}'
    spec:
      panels:
        MUobqH9IgbFHSaUR37jVG:
          spec:
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  format:
                    unit: short
            links: []
            queries:
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum by (cluster_name, namespace, pod_name)
                        (container_cpu_usage{cluster_name="${vars.clustername}",
                        namespace="${vars.namespace}",
                        pod_name="${vars.pod}"}) / 1000000000
                      alias: Current - ${cluster_name} - ${namespace} - ${pod_name}
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum by (cluster_name, namespace, pod_name)
                        (kubernetes_state_container_cpu_limit{cluster_name="${vars.clustername}",
                        namespace="${vars.namespace}",
                        pod_name="${vars.pod}"})
                      alias: Limit - ${cluster_name} - ${namespace} - ${pod_name}
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum by (cluster_name, namespace, pod_name)
                        (kubernetes_state_container_cpu_requested{cluster_name="${vars.clustername}",
                        namespace="${vars.namespace}",
                        pod_name="${vars.pod}"})
                      alias: Request - ${cluster_name} - ${namespace} - ${pod_name}
            display:
              name: CPU Usage
              description: ""
        f5LsPzdEs9pd_KL05AgvA:
          spec:
            plugin:
              kind: TimeSeriesChart
              spec:
                yAxis:
                  show: true
                  format:
                    unit: bytes(IEC)
                    decimalPlaces: 0
                legend:
                  show: true
                  position: bottom
                  mode: list
                  values: []
                thresholds:
                  mode: absolute
                  steps: []
                visual:
                  connectNulls: false
            links: []
            queries:
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum by (cluster_name, namespace, pod_name)
                        (kubernetes_state_container_memory_requested{cluster_name="${vars.clustername}",
                        namespace="${vars.namespace}",
                        pod_name="${vars.pod}"})
                      alias: Request - ${cluster_name} - ${namespace} - ${pod_name}
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum by (cluster_name, namespace, pod_name)
                        (kubernetes_state_container_memory_limit{cluster_name="${vars.clustername}",
                        namespace="${vars.namespace}",
                        pod_name="${vars.pod}"})
                      alias: Limit - ${cluster_name} - ${namespace} - ${pod_name}
              - kind: TimeSeriesQuery
                spec:
                  plugin:
                    kind: PrometheusTimeSeriesQuery
                    spec:
                      query: sum by (cluster_name, namespace, pod_name)
                        (container_memory_usage{cluster_name="${vars.clustername}",
                        namespace="${vars.namespace}",
                        pod_name="${vars.pod}"})
                      alias: Current - ${cluster_name} - ${namespace} - ${pod_name}
            display:
              name: Memory Usage
              description: ""
      layouts:
        - kind: Grid
          spec:
            items:
              - x: 0
                y: 0
                width: 8
                height: 2
                content:
                  $ref: "#/spec/panels/MUobqH9IgbFHSaUR37jVG"
              - x: 8
                y: 0
                width: 8
                height: 2
                content:
                  $ref: "#/spec/panels/f5LsPzdEs9pd_KL05AgvA"
      variables:
        - kind: ListVariable
          spec:
            plugin:
              kind: MetricLabelValues
              spec:
                labelName: cluster_name
                matchers:
                  - container_cpu_usage
            sort: none
            allowMultiple: false
            allowAllValue: false
            name: clustername
            display:
              name: Cluster name
              description: ""
        - kind: ListVariable
          spec:
            plugin:
              kind: MetricLabelValues
              spec:
                labelName: namespace
                matchers:
                  - container_cpu_usage{cluster_name="${vars.clustername}"}
            sort: none
            allowMultiple: false
            allowAllValue: false
            name: namespace
            display:
              name: Namespace
              description: ""
        - kind: ListVariable
          spec:
            plugin:
              kind: MetricLabelValues
              spec:
                labelName: pod_name
                matchers:
                  - container_cpu_usage{cluster_name="${vars.clustername}", namespace="${vars.namespace}"}
            sort: none
            allowMultiple: false
            allowAllValue: false
            name: pod
            display:
              name: Pod
              description: ""
